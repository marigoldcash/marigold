{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marigold",
  "version": "2.62.268",
  "identifier": "cash.marigold.wallet",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Marigold",
        "width": 520,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
