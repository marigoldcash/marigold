{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marigold",
  "version": "2.90.349",
  "identifier": "cash.marigold.wallet",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Marigold",
        "width": 980,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Marigold desktop wallet",
    "longDescription": "Digital cash in fixed notes: the Marigold wallet with screens instead of commands."
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE-WITH-THE-PUBLIC-KEY-FROM-cargo-tauri-signer-generate",
      "endpoints": [
        "https://marigold.cash/desktop.json"
      ]
    }
  }
}
