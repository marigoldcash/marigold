# Managed by Ansible (deploy/ansible/roles/monitoring-server).
# Targets are tailnet IPs (monitoring_bind_ip / bridge_prom_bind per host in
# inventory.ini) — scraping crosses hosts only over Tailscale.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  - job_name: node
    static_configs:
{% for host in groups['seed_nodes'] %}
      - targets: ["{{ hostvars[host]['monitoring_bind_ip'] }}:9100"]
        labels:
          node: "{{ host }}"
{% endfor %}

  - job_name: bridge
    static_configs:
{% for host in groups['bridges'] %}
      - targets: ["{{ hostvars[host]['bridge_prom_bind'] }}:{{ hostvars[host]['bridge_prom_port'] | default('2114') }}"]
        labels:
          node: "{{ host }}"
{% endfor %}

  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
