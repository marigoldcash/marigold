#!/bin/sh
# Managed by Ansible (deploy/ansible/roles/monitoring-agent).
# Emits marigold-specific gauges for node_exporter's textfile collector.
# Runs from marigold-metrics.timer every 30s.
set -eu
out={{ monitoring_textfile_dir }}/marigold.prom
tmp=$(mktemp "$out.XXXXXX")

# Established P2P connections (either direction on the testnet P2P port).
peers=$(ss -Htn state established '( sport = :26211 or dport = :26211 )' 2>/dev/null | wc -l)
printf 'marigold_p2p_peers %s\n' "$peers" >> "$tmp"

{% if monitoring_block_age_from_journal | bool %}
# Seconds since marigoldd last accepted a block, from its journal INFO lines.
# 999999 when no line is found in the window — deliberately alarm-worthy: an
# active node on this network logs acceptances every second.
line=$(journalctl -u marigoldd -o cat --since "-30 min" 2>/dev/null | grep -F 'Accepted' | tail -1 || true)
if [ -n "$line" ]; then
  ts=$(echo "$line" | awk '{print $1 "T" $2}')
  age=$(( $(date +%s) - $(date -d "$ts" +%s 2>/dev/null || echo 0) ))
else
  age=999999
fi
printf 'marigold_last_block_age_seconds %s\n' "$age" >> "$tmp"
{% endif %}

# Finality-anchor state as the node sees it, through the trustee signer's status
# probe over gRPC (added 2026-09-23 after the testnet ran two and a half hours in
# fail-open unnoticed: a lagging signer host had cost the quorum). `stale` is the
# spec's fail-open flag; `age_daa` is how far the latest anchor trails the sink.
status=$(timeout 10 /opt/marigold/bin/marigold-trustee-signer --rpc-server 127.0.0.1:26210 --drill-status 2>/dev/null || true)
case "$status" in *"enforcing true"*) enforcing=1 ;; *) enforcing=0 ;; esac
case "$status" in *"stale true"*) stale=1 ;; *) stale=0 ;; esac
sink=$(printf '%s' "$status" | sed -n 's/^sink [0-9a-f]* at DAA \([0-9]*\) .*/\1/p')
anchor=$(printf '%s' "$status" | sed -n 's/.*anchor at DAA \([0-9]*\) .*/\1/p')
if [ -n "$sink" ] && [ -n "$anchor" ]; then age_daa=$(( sink - anchor )); else age_daa=999999; fi
printf 'marigold_anchor_enforcing %s\n' "$enforcing" >> "$tmp"
printf 'marigold_anchor_stale %s\n' "$stale" >> "$tmp"
printf 'marigold_anchor_age_daa %s\n' "$age_daa" >> "$tmp"

chmod 644 "$tmp"
mv "$tmp" "$out"
