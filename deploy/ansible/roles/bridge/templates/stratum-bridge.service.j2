# Managed by Ansible (deploy/ansible/roles/bridge) — local edits will be overwritten.
[Unit]
Description=Marigold stratum-bridge ({{ marigold_network }})
# tailscaled ordering matters only when bridge_prom_bind is a tailnet IP (the
# bind fails until the interface exists); systemd ignores After= on units that
# aren't installed, and Restart=on-failure self-heals the race regardless.
After=network-online.target marigoldd.service tailscaled.service
Wants=network-online.target
Requires=marigoldd.service

[Service]
Type=simple
User={{ marigold_user }}
Group={{ marigold_user }}
WorkingDirectory={{ marigold_config_root }}
# --node-mode external is the load-bearing flag here: stratum-bridge defaults to
# spawning its OWN embedded kaspad (--node-mode inprocess) if you don't pass
# this, which would start a second, separate node process competing for this
# same host's P2P/data — not what we want when kaspad already runs as its own
# systemd unit. external mode just connects to config.yaml's kaspad_address.
{% if bridge_prom_bind is defined and bridge_prom_bind != '127.0.0.1' %}
# The prom listener binds a tailnet IP, and After=tailscaled only orders
# against the daemon starting — not the address being assigned. The bridge
# doesn't crash on a failed prom bind (it logs and mines on, metrics silently
# missing — caught by the reboot-survival test, 2026-09-04), so waiting for
# the address here is the only reliable fix.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do ip -o addr show | grep -qF "{{ bridge_prom_bind }}" && exit 0; sleep 1; done; echo "tailnet address {{ bridge_prom_bind }} never appeared" >&2; exit 1'
{% endif %}
ExecStart={{ marigold_install_root }}/bin/stratum-bridge \
  --config {{ marigold_config_root }}/bridge-config.yaml \
  --node-mode external
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
